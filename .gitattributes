# Normalize line endings to LF in the repository regardless of OS.
# Git will still check out files with your OS's native line endings
# locally (CRLF on Windows) if core.autocrlf is set appropriately --
# this just keeps the repo itself consistent so diffs don't get noisy.

* text=auto eol=lf

*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf

# Binary files -- do not touch line endings
*.png binary
*.jpg binary
*.zip binary
