# ---- Local Postgres (used until we switch to Supabase) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_cab_db

# ---- Supabase (fill these in when we migrate) ----
# DATABASE_URL=postgresql://postgres:[password]@db.xxxxx.supabase.co:5432/postgres
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- App ----
ENVIRONMENT=development
services:
  db:
    image: postgres:16
    container_name: smart_cab_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: smart_cab_db
    ports:
      - "5441:5432"
    volumes:
      - smart_cab_pgdata:/var/lib/postgresql/data
      - ./backend/migrations:/docker-entrypoint-initdb.d

  backend:
    build: ./backend
    container_name: smart_cab_backend
    restart: unless-stopped
    depends_on:
      - db
    env_file:
      - ./backend/.env
    environment:
      # Overrides whatever DATABASE_URL is in .env -- inside Docker's
      # internal network the backend reaches Postgres via the service
      # name "db" on its internal port 5432, regardless of which host
      # port we've mapped Postgres to (5441).
      DATABASE_URL: postgresql://postgres:postgres@db:5432/smart_cab_db
    ports:
      - "8000:8000"

volumes:
  smart_cab_pgdata:
