# ---- Local Postgres (used until we switch to Supabase) ----
# This is the HOST-side address -- used when running Python directly
# on your machine (e.g. `python scripts/seed_db.py`, or `make run`
# outside Docker). The backend container itself uses a different
# internal address (db:5432) set directly in docker-compose.yml --
# you don't need to change that separately.
DATABASE_URL=postgresql://postgres:postgres@localhost:5441/smart_cab_db

# ---- Supabase (fill these in when we migrate) ----
# DATABASE_URL=postgresql://postgres:[password]@db.xxxxx.supabase.co:5432/postgres
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Email (Gmail SMTP) ----
# See backend/README.md "Email setup" for how to get an App Password.
# GMAIL_ADDRESS must be a real Gmail account with 2-Step Verification
# enabled; GMAIL_APP_PASSWORD is the 16-character App Password Google
# generates for you (NOT your normal Gmail password).
GMAIL_ADDRESS=your-project-gmail@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- App ----
ENVIRONMENT=development
